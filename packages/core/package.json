{
  "name": "@fluenti/core",
  "version": "0.6.3",
  "type": "module",
  "description": "Framework-agnostic compile-time i18n core — ICU parser, compiler, interpolation, formatters",
  "homepage": "https://fluenti.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usefluenti/fluenti.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/usefluenti/fluenti/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": ["i18n", "internationalization", "compile-time", "icu", "messageformat", "plural", "select", "ssr", "formatters"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.ts", "default": "./dist/index.cjs" }
    },
    "./runtime": {
      "import": { "types": "./dist/runtime.d.ts", "default": "./dist/runtime.js" },
      "require": { "types": "./dist/runtime.d.ts", "default": "./dist/runtime.cjs" }
    },
    "./compiler": {
      "import": { "types": "./dist/compiler.d.ts", "default": "./dist/compiler.js" },
      "require": { "types": "./dist/compiler.d.ts", "default": "./dist/compiler.cjs" }
    },
    "./transform": {
      "import": { "types": "./dist/transform.d.ts", "default": "./dist/transform.js" },
      "require": { "types": "./dist/transform.d.ts", "default": "./dist/transform.cjs" }
    },
    "./transform/browser": {
      "import": { "types": "./dist/transform-browser.d.ts", "default": "./dist/transform-browser.js" },
      "require": { "types": "./dist/transform-browser.d.ts", "default": "./dist/transform-browser.cjs" }
    },
    "./ssr": {
      "import": { "types": "./dist/ssr-entry.d.ts", "default": "./dist/ssr-entry.js" },
      "require": { "types": "./dist/ssr-entry.d.ts", "default": "./dist/ssr-entry.cjs" }
    },
    "./formatters": {
      "import": { "types": "./dist/formatters-entry.d.ts", "default": "./dist/formatters-entry.js" },
      "require": { "types": "./dist/formatters-entry.d.ts", "default": "./dist/formatters-entry.cjs" }
    },
    "./config": {
      "import": { "types": "./dist/config.d.ts", "default": "./dist/config.js" },
      "require": { "types": "./dist/config.d.ts", "default": "./dist/config.cjs" }
    }
  },
  "files": ["dist", "llms*.txt"],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench"
  },
  "dependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.28.4",
    "jiti": "^2"
  },
  "devDependencies": {
    "typescript": "^6.0",
    "vite": "^8",
    "vite-plugin-dts": "^4",
    "vitest": "^4",
    "@vitest/coverage-v8": "^4"
  }
}
