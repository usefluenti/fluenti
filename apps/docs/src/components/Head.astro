---
import Default from '@astrojs/starlight/components/Head.astro'

const { starlightRoute } = Astro.locals
const url = Astro.url
const isHome = url.pathname === '/' || url.pathname === ''
const site = Astro.site?.origin ?? 'https://fluenti.dev'

// Build dynamic OG image URL from the page slug
const slug = url.pathname.replace(/^\/|\/$/g, '')
const ogImageUrl = slug
  ? `${site}/og/${slug}.png`
  : `${site}/og-image.png`

// Build breadcrumb from URL path
const segments = url.pathname.replace(/^\/|\/$/g, '').split('/').filter(Boolean)

const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site },
]

const labelMap: Record<string, string> = {
  start: 'Start Here',
  essentials: 'Essentials',
  frameworks: 'Frameworks',
  advanced: 'Advanced',
  api: 'API Reference',
  vue: 'Vue',
  react: 'React',
  solid: 'SolidJS',
  nuxt: 'Nuxt',
}

let pathSoFar = ''
for (let i = 0; i < segments.length; i++) {
  pathSoFar += `/${segments[i]}`
  const isLast = i === segments.length - 1
  const name = isLast
    ? (starlightRoute?.entry?.data?.title ?? segments[i])
    : (labelMap[segments[i]] ?? segments[i])

  breadcrumbItems.push({
    '@type': 'ListItem',
    position: i + 2,
    name,
    item: `${site}${pathSoFar}/`,
  })
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
}

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Fluenti',
  url: site,
  logo: `${site}/assets/logo-icon.svg`,
  sameAs: ['https://github.com/usefluenti/fluenti'],
}

const softwareAppLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Fluenti',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Cross-platform',
  description: 'Compile-time i18n for Vue, React, SolidJS, Next.js and Nuxt',
  url: site,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://opensource.org/licenses/MIT',
}

const isFaq = url.pathname.includes('/faq')

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is Fluenti?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Fluenti is a compile-time i18n (internationalization) library for modern JavaScript frameworks. Unlike traditional i18n libraries that parse ICU messages at runtime, Fluenti compiles translations during your build step into optimized string concatenation functions. This means zero runtime parsing overhead, smaller bundles, and faster rendering.',
      },
    },
    {
      '@type': 'Question',
      name: 'Why compile-time instead of runtime?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Compile-time translation eliminates the need to ship an ICU parser to the browser, resulting in significantly smaller bundles and faster rendering. The trade-off is that you need a build step, but since most modern frameworks already require one (Vite, webpack, Turbopack), this fits naturally into existing workflows.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which frameworks does Fluenti support?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Fluenti supports Vue 3, React, SolidJS, Next.js (App Router with RSC), Nuxt 3, React Router v7, TanStack Start, and SolidStart. Each framework has a dedicated integration package with components, hooks, and a build plugin.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is Fluenti free?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Fluenti is fully open source under the MIT license. You can use it in personal and commercial projects without restrictions.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I migrate from vue-i18n?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Install the @fluenti/vue-i18n-compat bridge package to run both vue-i18n and Fluenti side by side. This lets you migrate incrementally -- existing $t() calls continue to work while you adopt Fluenti\'s v-t directive and t tagged template in new code.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I migrate from react-i18next?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Use the fluenti migrate --from react-i18next CLI command, which provides AI-assisted migration of your existing translation files and component code. It converts useTranslation() calls to Fluenti\'s useI18n() hook and rewrites JSX to use the t tagged template or Trans component.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use Fluenti alongside my existing i18n library?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The vue-i18n bridge allows gradual migration for Vue projects by providing a compatibility layer that proxies calls to both libraries. For React projects, you can run both react-i18next and Fluenti in parallel during migration since they use separate context providers.',
      },
    },
    {
      '@type': 'Question',
      name: 'What message format does Fluenti use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Fluenti uses ICU MessageFormat with full support for plurals, selects, nested arguments, and custom formatters. Messages are written in a standard syntax understood by most translation tools, then compiled to optimized JavaScript functions at build time.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does Fluenti support SSR?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Fluenti provides SSR support across all supported frameworks with cookie, query parameter, URL path, and header-based locale detection. A hydration-safe script helper ensures the client picks up the server-rendered locale without a flash of untranslated content.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does code splitting work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The Vite plugin can split translation messages per route using dynamic or static strategies. When configured, each locale chunk is loaded on demand via dynamic imports, so users only download the translations they need for the current page.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does Fluenti work with Turbopack?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The Next.js plugin (@fluenti/next) supports both webpack and Turbopack. The withFluenti() wrapper in next.config.ts automatically configures the appropriate loader for whichever bundler Next.js is using.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the runtime overhead?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Near zero. Compiled messages are either pre-resolved strings (for static text) or simple template functions that concatenate interpolated values. No ICU parser runs at runtime, so there is no parsing cost on every render.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does bundle size compare to other i18n libraries?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Fluenti's runtime is approximately 2-4 KB gzipped, varying slightly by framework integration. Traditional i18n libraries ship 15-40 KB parsers to the browser because they interpret ICU messages at runtime.",
      },
    },
    {
      '@type': 'Question',
      name: 'How do translators work with Fluenti?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Extract messages from source code with fluenti extract, which produces PO files in the standard gettext format that translators already know. Translators edit PO files with any translation tool (Poedit, Weblate, Crowdin, etc.), and you compile the results with fluenti compile.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use JSON instead of PO files?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Set format: \'json\' in your fluenti.config.ts to use JSON catalogs instead of PO files. Both formats support all Fluenti features including plurals, context, and metadata.',
      },
    },
  ],
}

const schemas = isHome
  ? [organizationLd, softwareAppLd, breadcrumbLd]
  : isFaq
    ? [breadcrumbLd, faqLd]
    : [breadcrumbLd]
---

<Default><slot /></Default>

<!-- Per-page OG image (overrides the global static og:image) -->
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta name="twitter:image" content={ogImageUrl} />

{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
