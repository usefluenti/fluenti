---
import Default from '@astrojs/starlight/components/Head.astro'

const { starlightRoute } = Astro.locals
const url = Astro.url
const isHome = url.pathname === '/' || url.pathname === ''
const site = Astro.site?.origin ?? 'https://fluenti.dev'

// Build dynamic OG image URL from the page slug
const slug = url.pathname.replace(/^\/|\/$/g, '')
const ogImageUrl = slug
  ? `${site}/og/${slug}.png`
  : `${site}/og-image.png`

// Build breadcrumb from URL path
const segments = url.pathname.replace(/^\/|\/$/g, '').split('/').filter(Boolean)

const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site },
]

const labelMap: Record<string, string> = {
  start: 'Start Here',
  essentials: 'Essentials',
  frameworks: 'Frameworks',
  advanced: 'Advanced',
  api: 'API Reference',
  vue: 'Vue',
  react: 'React',
  solid: 'SolidJS',
  nuxt: 'Nuxt',
}

let pathSoFar = ''
for (let i = 0; i < segments.length; i++) {
  pathSoFar += `/${segments[i]}`
  const isLast = i === segments.length - 1
  const name = isLast
    ? (starlightRoute?.entry?.data?.title ?? segments[i])
    : (labelMap[segments[i]] ?? segments[i])

  breadcrumbItems.push({
    '@type': 'ListItem',
    position: i + 2,
    name,
    item: `${site}${pathSoFar}/`,
  })
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
}

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Fluenti',
  url: site,
  logo: `${site}/assets/logo-icon.svg`,
  sameAs: ['https://github.com/usefluenti/fluenti'],
}

const softwareAppLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Fluenti',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Cross-platform',
  description: 'Compile-time i18n for Vue, React, SolidJS, Next.js and Nuxt',
  url: site,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://opensource.org/licenses/MIT',
}

// Route classification
const isFaq = url.pathname.includes('/faq')
const isBlog = url.pathname.includes('/blog/')
const isApi = segments[0] === 'api'
const isQuickStart = url.pathname.includes('/quick-start')
const isGuide = !isHome && !isFaq && !isBlog && !isApi && !isQuickStart

const pageTitle = starlightRoute?.entry?.data?.title ?? ''
const pageDescription = starlightRoute?.entry?.data?.description ?? ''
const pageUrl = `${site}${url.pathname}`

const fluentiAuthor = { '@type': 'Organization', name: 'Fluenti', url: site }

// TechArticle — guides, tutorials, essentials, advanced
const techArticleLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: pageTitle,
  description: pageDescription,
  url: pageUrl,
  image: ogImageUrl,
  author: fluentiAuthor,
  publisher: fluentiAuthor,
  inLanguage: 'en',
  isAccessibleForFree: true,
  proficiencyLevel: segments[0] === 'advanced' ? 'Expert' : 'Beginner',
}

// BlogPosting — blog pages
const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: pageTitle,
  description: pageDescription,
  url: pageUrl,
  image: ogImageUrl,
  author: fluentiAuthor,
  publisher: fluentiAuthor,
  inLanguage: 'en',
  isAccessibleForFree: true,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
}

// Detect framework from quick-start slug
const qsFramework = (() => {
  const match = url.pathname.match(/quick-start-(\w+)/)
  if (match) {
    const map: Record<string, string> = {
      vue: 'Vue 3', react: 'React', solid: 'SolidJS', nuxt: 'Nuxt 3',
      nextjs: 'Next.js', solidstart: 'SolidStart',
      'react-router': 'React Router', 'tanstack-start': 'TanStack Start',
    }
    return map[match[1]] ?? match[1]
  }
  return null
})()

// HowTo — quick-start pages
const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: qsFramework
    ? `Set up Fluenti with ${qsFramework}`
    : 'Set up Fluenti in your project',
  description: pageDescription,
  url: pageUrl,
  image: ogImageUrl,
  totalTime: 'PT5M',
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Install packages', text: `Install @fluenti/core and the framework integration package via your package manager.` },
    { '@type': 'HowToStep', position: 2, name: 'Configure the build plugin', text: 'Add the Fluenti Vite/webpack plugin to your build configuration.' },
    { '@type': 'HowToStep', position: 3, name: 'Create fluenti.config.ts', text: 'Define source locale, target locales, catalog directory, and format.' },
    { '@type': 'HowToStep', position: 4, name: 'Use translations in components', text: 'Write translatable text using the t tagged template or framework-specific directives and components.' },
    { '@type': 'HowToStep', position: 5, name: 'Extract and compile', text: 'Run fluenti extract to generate translation catalogs, then fluenti compile to produce optimized runtime bundles.' },
  ],
}

// SoftwareSourceCode — API reference pages
const apiPackageName = isApi && segments[1]
  ? `@fluenti/${segments[1].replace('vue-i18n-compat', 'vue-i18n-compat')}`
  : '@fluenti/core'

const softwareSourceCodeLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: apiPackageName,
  description: pageDescription,
  url: pageUrl,
  codeRepository: 'https://github.com/usefluenti/fluenti',
  programmingLanguage: ['TypeScript', 'JavaScript'],
  runtimePlatform: 'Node.js',
  license: 'https://opensource.org/licenses/MIT',
}

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is Fluenti?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Fluenti is a compile-time i18n (internationalization) library for modern JavaScript frameworks. Unlike traditional i18n libraries that parse ICU messages at runtime, Fluenti compiles translations during your build step into optimized string concatenation functions. This means zero runtime parsing overhead, smaller bundles, and faster rendering.',
      },
    },
    {
      '@type': 'Question',
      name: 'Why compile-time instead of runtime?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Compile-time translation eliminates the need to ship an ICU parser to the browser, resulting in significantly smaller bundles and faster rendering. The trade-off is that you need a build step, but since most modern frameworks already require one (Vite, webpack, Turbopack), this fits naturally into existing workflows.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which frameworks does Fluenti support?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Fluenti supports Vue 3, React, SolidJS, Next.js (App Router with RSC), Nuxt 3, React Router v7, TanStack Start, and SolidStart. Each framework has a dedicated integration package with components, hooks, and a build plugin.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is Fluenti free?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Fluenti is fully open source under the MIT license. You can use it in personal and commercial projects without restrictions.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I migrate from vue-i18n?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Install the @fluenti/vue-i18n-compat bridge package to run both vue-i18n and Fluenti side by side. This lets you migrate incrementally -- existing $t() calls continue to work while you adopt Fluenti\'s v-t directive and t tagged template in new code.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I migrate from react-i18next?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Use the fluenti migrate --from react-i18next CLI command, which provides AI-assisted migration of your existing translation files and component code. It converts useTranslation() calls to Fluenti\'s useI18n() hook and rewrites JSX to use the t tagged template or Trans component.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use Fluenti alongside my existing i18n library?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The vue-i18n bridge allows gradual migration for Vue projects by providing a compatibility layer that proxies calls to both libraries. For React projects, you can run both react-i18next and Fluenti in parallel during migration since they use separate context providers.',
      },
    },
    {
      '@type': 'Question',
      name: 'What message format does Fluenti use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Fluenti uses ICU MessageFormat with full support for plurals, selects, nested arguments, and custom formatters. Messages are written in a standard syntax understood by most translation tools, then compiled to optimized JavaScript functions at build time.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does Fluenti support SSR?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Fluenti provides SSR support across all supported frameworks with cookie, query parameter, URL path, and header-based locale detection. A hydration-safe script helper ensures the client picks up the server-rendered locale without a flash of untranslated content.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does code splitting work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The Vite plugin can split translation messages per route using dynamic or static strategies. When configured, each locale chunk is loaded on demand via dynamic imports, so users only download the translations they need for the current page.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does Fluenti work with Turbopack?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The Next.js plugin (@fluenti/next) supports both webpack and Turbopack. The withFluenti() wrapper in next.config.ts automatically configures the appropriate loader for whichever bundler Next.js is using.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the runtime overhead?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Near zero. Compiled messages are either pre-resolved strings (for static text) or simple template functions that concatenate interpolated values. No ICU parser runs at runtime, so there is no parsing cost on every render.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does bundle size compare to other i18n libraries?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Fluenti's runtime is approximately 2-4 KB gzipped, varying slightly by framework integration. Traditional i18n libraries ship 15-40 KB parsers to the browser because they interpret ICU messages at runtime.",
      },
    },
    {
      '@type': 'Question',
      name: 'How do translators work with Fluenti?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Extract messages from source code with fluenti extract, which produces PO files in the standard gettext format that translators already know. Translators edit PO files with any translation tool (Poedit, Weblate, Crowdin, etc.), and you compile the results with fluenti compile.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use JSON instead of PO files?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Set format: \'json\' in your fluenti.config.ts to use JSON catalogs instead of PO files. Both formats support all Fluenti features including plurals, context, and metadata.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the fastest JavaScript i18n library?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Fluenti is 5-10x faster than runtime-interpreted i18n libraries like vue-i18n and react-i18next, widening to 40x on complex ICU messages. This is because Fluenti compiles translations at build time — no ICU parser runs in the browser. Pre-compiled function calls reach ~10M ops/sec.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which i18n library has the smallest bundle size?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Fluenti\'s runtime is approximately 3 KB gzipped. Traditional i18n libraries range from 12-14 KB (next-intl, react-i18next, vue-i18n) because they include a runtime ICU parser. Compile-time libraries like Fluenti and LinguiJS avoid shipping a parser to the browser.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which i18n library supports the most frameworks?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Fluenti is the only i18n library with first-class support for Vue, React, SolidJS, Next.js, Nuxt, React Router, TanStack Start, and SolidStart from a single codebase. Most alternatives support only one framework: vue-i18n (Vue), react-i18next (React), next-intl (Next.js).',
      },
    },
  ],
}

// vs page FAQ schemas
const isVsVueI18n = url.pathname.includes('/fluenti-vs-vue-i18n')
const isVsReactI18next = url.pathname.includes('/fluenti-vs-react-i18next')
const isVsNextIntl = url.pathname.includes('/fluenti-vs-next-intl')
const isChoosingGuide = url.pathname.includes('/choosing-i18n-library')
const isVsPage = isVsVueI18n || isVsReactI18next || isVsNextIntl
const isComparisonPage = isVsPage || isChoosingGuide

const vsVueI18nFaqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is Fluenti faster than vue-i18n?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Fluenti is 5-10x faster than vue-i18n because it compiles ICU messages at build time. vue-i18n parses messages at runtime on every render. On complex messages with nested plurals and selects, the difference widens to 40x.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is Fluenti smaller than vue-i18n?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Fluenti\'s runtime is ~3 KB gzipped, while vue-i18n is ~14 KB gzipped. Fluenti is smaller because it does not ship an ICU parser to the browser — messages are pre-compiled at build time.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I migrate from vue-i18n to Fluenti?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Install the @fluenti/vue-i18n-compat bridge package to run both libraries side by side. Existing $t() calls continue to work while you incrementally adopt Fluenti\'s v-t directive and t tagged template in new code.',
      },
    },
  ],
}

const vsReactI18nextFaqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is Fluenti better than react-i18next?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Fluenti offers a smaller bundle (~3 KB vs ~13 KB), 5-10x faster performance (no runtime parsing), and dedicated Next.js RSC support. react-i18next has a larger ecosystem and more community resources. The best choice depends on your priorities.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does Fluenti work with Next.js?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Fluenti has a dedicated @fluenti/next package with App Router support, React Server Components, streaming SSR, and Turbopack compatibility. It provides withFluenti() for next.config.ts and server-side locale detection middleware.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I migrate from react-i18next to Fluenti?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Use the fluenti migrate --from react-i18next CLI command for AI-assisted migration. It converts useTranslation() calls to useI18n() and rewrites JSX to use the t tagged template or Trans component.',
      },
    },
  ],
}

const vsNextIntlFaqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is Fluenti faster than next-intl?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Fluenti compiles messages at build time, eliminating runtime parsing entirely. next-intl interprets ICU messages at runtime. This makes Fluenti 5-10x faster, with the gap widening to 40x on complex messages.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can Fluenti replace next-intl?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Fluenti\'s @fluenti/next package provides the same Next.js capabilities (App Router, RSC, Turbopack, middleware) plus works across Vue, SolidJS, React Router, TanStack Start, and more — making your i18n investment portable.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does Fluenti support React Server Components?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Fluenti provides a dedicated server API for React Server Components with async locale loading, server-side translation functions, and hydration-safe client handoff.',
      },
    },
  ],
}

const choosingGuideFaqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the fastest i18n library for JavaScript?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Compile-time i18n libraries like Fluenti and LinguiJS are the fastest because they pre-compile messages during the build step. Fluenti achieves ~10M ops/sec for pre-compiled function calls, which is 5-10x faster than runtime-interpreted libraries like vue-i18n, react-i18next, and next-intl.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which i18n library has the smallest bundle?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Fluenti has the smallest runtime at ~3 KB gzipped, followed by LinguiJS at ~5 KB. Runtime-based libraries are larger: next-intl (~12 KB), react-i18next (~13 KB), and vue-i18n (~14 KB). The difference is the ICU parser that runtime libraries must ship to the browser.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which i18n library works with the most frameworks?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Fluenti supports 8 frameworks from a single codebase: Vue, React, SolidJS, Next.js, Nuxt, React Router, TanStack Start, and SolidStart. Most alternatives support only one framework. LinguiJS supports React and experimental Vue. This makes Fluenti the best choice for monorepos and cross-framework teams.',
      },
    },
  ],
}

const schemas: Record<string, unknown>[] = [breadcrumbLd]

if (isHome) {
  schemas.push(organizationLd, softwareAppLd)
} else if (isFaq) {
  schemas.push(faqLd)
} else if (isVsVueI18n) {
  schemas.push(techArticleLd, vsVueI18nFaqLd)
} else if (isVsReactI18next) {
  schemas.push(techArticleLd, vsReactI18nextFaqLd)
} else if (isVsNextIntl) {
  schemas.push(techArticleLd, vsNextIntlFaqLd)
} else if (isChoosingGuide) {
  schemas.push(techArticleLd, choosingGuideFaqLd)
} else if (isBlog) {
  schemas.push(blogPostingLd)
} else if (isQuickStart) {
  schemas.push(howToLd)
} else if (isApi) {
  schemas.push(softwareSourceCodeLd)
} else if (isGuide) {
  schemas.push(techArticleLd)
}
---

<Default><slot /></Default>

<!-- RSS feed discovery -->
<link rel="alternate" type="application/rss+xml" title="Fluenti Blog" href={`${site}/rss.xml`} />

<!-- Per-page OG image (overrides the global static og:image) -->
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta name="twitter:image" content={ogImageUrl} />

{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
